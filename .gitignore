# Dependencies
node_modules/

# Rust build artifacts
src-tauri/target/
src-tauri/binaries/*.exe
dist/

# Fontshare originals are fetched directly, then embedded in the application.
src-tauri/assets/fonts/*.ttf
src-tauri/assets/fonts/*.otf

# Large model files
scripts/gector-onnx/
*.onnx
*.bin

# Wrangler local state
.wrangler/

# Large zips
*.zip

# Dev documentation (except README)
*.md
!README.md
!AGENTS.md
!src-tauri/assets/fonts/README.md
!docs/native-validation.md

# OAuth credentials (never commit secrets)
oauth.config.json
